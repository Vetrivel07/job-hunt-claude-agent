# Copy this file to .env and fill it in. .env is ignored by git; never commit it.

# Where career-ops lives (default: the career-ops folder next to this one)
CAREER_OPS_DIR=<path-to>\career-ops

# ---- How much work per day ---------------------------------------------
# Full evaluations are the expensive step (each one is a long Claude session).
# On Claude Pro, 5-8 a day is a sensible ceiling. Extra good matches roll over.
MAX_EVALS_PER_RUN=6
# Score needed for "apply" + cover letter (career-ops recommends 4.0)
MIN_SCORE=4.0
# Parallel evaluation workers (lower = gentler on usage limits)
BATCH_PARALLEL=2
# full = report + tailored CV PDF;  match = cheaper condensed report, no PDF
BATCH_MODE=full
# Max postings sent to the screening step in one run
MAX_TRIAGE_POSTINGS=250

# ---- Cover letters --------------------------------------------------------
COVER_LETTERS=true
COVER_TONE=Direct: plain sentences, gets to the point, professional
# Optional: model for screening + cover letters (blank = your Claude Code default)
CLAUDE_MODEL=

# ---- Spreadsheet ----------------------------------------------------------
# Default: job-log.xlsx in this folder
EXCEL_PATH=
TIMEZONE=America/New_York

# ---- WhatsApp -------------------------------------------------------------
# callmebot (free, to your own number) | twilio | none (print only)
WHATSAPP_PROVIDER=callmebot

# CallMeBot: follow https://www.callmebot.com/blog/free-api-whatsapp-messages/
# to get your API key, then put your number with country code here.
CALLMEBOT_PHONE=+1XXXXXXXXXX
CALLMEBOT_APIKEY=

# Twilio (only if WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
TWILIO_TO=whatsapp:+1XXXXXXXXXX

# ---- Windows --------------------------------------------------------------
# Leave blank to auto-detect C:\Program Files\Git\bin\bash.exe
GIT_BASH=
